{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model",
  "description": "ModelRegistry entry (TASK-016A, MASTER_PLAN §32.4). Required metadata for every downloadable model. download-critical fields are 'pinned' only when non-empty (checksum) / non-zero (size); unpinned entries are listed but never resolved as available.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "source",
    "download_url",
    "expected_size_bytes",
    "checksum",
    "license",
    "required_vram_mb",
    "supported_backend"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "download_url": {
      "type": "string",
      "minLength": 1
    },
    "expected_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "checksum": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|)$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "required_vram_mb": {
      "type": "number",
      "minimum": 0
    },
    "supported_backend": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["faster-whisper", "whisper-cpp"]
      }
    }
  }
}
