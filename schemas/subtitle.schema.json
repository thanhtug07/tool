{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subtitle",
  "description": "Subtitle document: generated cues plus style configuration and rendered ASS/SRT output paths (MASTER_PLAN 24.3). Persisted artifact, versioned via schema_version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "style", "cues", "output"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "$ref": "#/$defs/SubtitleStyle"
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Cue"
      }
    },
    "output": {
      "$ref": "#/$defs/SubtitleOutput"
    }
  },
  "$defs": {
    "SubtitleStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font", "font_size", "stroke", "shadow", "position", "bg_box", "max_chars_per_line", "max_cps"],
      "properties": {
        "font": {
          "type": "string",
          "minLength": 1
        },
        "font_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "stroke": {
          "type": "integer",
          "minimum": 0
        },
        "shadow": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "type": "string",
          "enum": ["bottom_center", "top_center"]
        },
        "bg_box": {
          "type": "boolean"
        },
        "max_chars_per_line": {
          "type": "integer",
          "minimum": 1
        },
        "max_cps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cue_number", "start", "end", "text"],
      "properties": {
        "cue_number": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SubtitleOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ass_path": {
          "type": ["string", "null"]
        },
        "srt_path": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
