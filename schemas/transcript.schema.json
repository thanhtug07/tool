{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transcript",
  "description": "Transcript document output by the STT stage (MASTER_PLAN 24.1). Persisted artifact, versioned via schema_version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "language", "model", "segments"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 8
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/TranscriptSegment"
      }
    }
  },
  "$defs": {
    "TranscriptSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "idx", "start", "end", "text", "language", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^seg_[0-9]+$"
        },
        "idx": {
          "type": "integer",
          "minimum": 0
        },
        "speaker": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Word"
          }
        }
      }
    },
    "Word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "start", "end"],
      "properties": {
        "word": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "speaker": {
          "type": "string"
        }
      }
    }
  }
}
